# =====================================================================================================
# SeismoHub configuration / SeismoHub 配置
#
#   cp .env.example .env      # then fill in what you need / 然后按需填写
#
# .env is git-ignored. Never commit real keys. / .env 已被 git 忽略，切勿提交真实密钥。
# Everything except the AI key is optional. / 除 AI 密钥外，其余都可选。
# =====================================================================================================


# -----------------------------------------------------------------------------------------------------
# 1. AI model (Google Gemini) / AI 模型（Google Gemini）
# -----------------------------------------------------------------------------------------------------
# Vertex AI API key (Google Cloud console -> Vertex AI -> API keys; "express mode" keys work).
# Required for the AI paper analysis. Q&A chat and embeddings use it too.
# Vertex AI API 密钥（Google Cloud 控制台 -> Vertex AI -> API 密钥；express 模式密钥即可）。
# AI 论文分析必须用它；问答和语义向量也会用它。
VERTEX_AI_API_KEY=
# Your Google Cloud project ID (needed for models routed through the project, e.g. gemini-4-argon).
# 你的 Google Cloud 项目 ID（经项目路由的模型需要，例如 gemini-4-argon）。
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=global

# Optional fallback: a Gemini Developer API key (Google AI Studio). Used for Q&A chat and embeddings
# when VERTEX_AI_API_KEY is empty. The full-PDF analysis still needs the Vertex key.
# 可选回退：Gemini Developer API 密钥（Google AI Studio）。未设置 Vertex 密钥时用于问答和语义向量；
# 整篇 PDF 分析仍需要 Vertex 密钥。
# GEMINI_API_KEY=

# Model overrides (defaults shown). Model availability depends on your key and region.
# 模型覆盖（以下为默认值）。可用模型取决于你的密钥与区域。
# SEISMO_PDF_ANALYSIS_MODEL=gemini-4-argon        # PDF layer: detail for the paper view only
# SEISMO_METADATA_ANALYSIS_MODEL=gemini-3.5-flash # title/abstract analysis: topics, relevance, classification
# SEISMO_DOMAIN_GATE_MODEL=gemini-3.8-flash
# GEMINI_MODEL=gemini-3.1-pro-preview          # Q&A chat / 问答
# SEISMO_ANALYSIS_MAX_TOKENS=65535

# Embeddings for semantic tracker matching (same credentials as above; no extra key).
# Changing the model or dimension after a bulk embed means re-embedding everything.
# 追踪器语义匹配用的向量（复用上面的凭据，无需额外密钥）。批量嵌入后再改模型或维度需全部重嵌入。
# EMBED_MODEL=text-multilingual-embedding-002
# EMBED_DIM=768
# EMBED_MAX_BATCH=20


# -----------------------------------------------------------------------------------------------------
# 2. Cost controls / 费用控制
# -----------------------------------------------------------------------------------------------------
# By default the server analyses EVERY paper in the background as soon as it arrives, which spends API
# credit. This template turns that off: papers are then analysed when you open them.
# Delete the line (or set it to 0) to analyse everything proactively.
# 默认情况下，服务会在后台主动分析每一篇新论文，会消耗 API 额度。本模板默认关闭它：论文会在你打开时再分析。
# 删除这一行（或设为 0）即可恢复后台全量分析。
DISABLE_EAGER_ANALYSIS=1
# SEISMO_EAGER_ANALYSIS_WORKERS=5        # parallel analyses (1-8) / 并行分析数
# SEISMO_EAGER_ANALYSIS_BATCH=20         # papers per pass / 每轮篇数
# SEISMO_EAGER_ANALYSIS_IDLE_SEC=60
# SEISMO_EAGER_ANALYSIS_BACKOFF_SEC=600
# SEISMO_EAGER_ANALYSIS_GAP_SEC=1.0

# A cheap flash-model check that keeps off-topic papers out of the library during fetches. 0 = off.
# 抓取时用便宜的 flash 模型过滤与地震学无关的论文。0 = 关闭。
# SEISMO_LLM_DOMAIN_GATE=1


# -----------------------------------------------------------------------------------------------------
# 3. Literature metadata sources / 文献元数据来源
# -----------------------------------------------------------------------------------------------------
# Contact e-mail sent to OpenAlex / Crossref / Unpaywall (their "polite pool"). Use your own address.
# 发给 OpenAlex / Crossref / Unpaywall 的联系邮箱（礼貌池）。请填你自己的邮箱。
PIPELINE_CONTACT_EMAIL=you@example.org
# UNPAYWALL_EMAIL=                        # defaults to noreply@example.invalid / 默认 noreply@example.invalid

# Optional: ETH Zurich Research Collection API key (adds ETH-authored papers to fetches).
# 可选：ETH Zurich Research Collection API 密钥（抓取时加入 ETH 作者的论文）。
# ETH_RC_API_KEY=


# -----------------------------------------------------------------------------------------------------
# 4. Web search enrichment for the AI analysis (optional) / AI 分析的网络检索补充（可选）
# -----------------------------------------------------------------------------------------------------
# Google Programmable Search: an API key + a search engine ID (cx).
# Google 可编程搜索：API 密钥 + 搜索引擎 ID（cx）。
# GOOGLE_CUSTOM_SEARCH_API_KEY=
# GOOGLE_CSE_CX=


# -----------------------------------------------------------------------------------------------------
# 5. Full-text PDF harvesting (scripts/harvest_pdfs.py) / 全文 PDF 抓取
#    See docs/PDF_HARVESTING.md. / 详见 docs/PDF_HARVESTING_zh.md
# -----------------------------------------------------------------------------------------------------
# You may put these keys here, or (recommended) in ~/.config/seismo_harvester/keys.env, outside the repo:
#     export ELSEVIER_API_KEY="..."
# 这些密钥可以写在这里，也可以（推荐）写在仓库外的 ~/.config/seismo_harvester/keys.env 中。
#
# Publisher TDM keys are tied to YOUR institution's licence. Copies obtained with them are kept local
# (paper_bundles/) and are never sent to hosted AI; see the licence rules in the docs.
# 出版商 TDM 密钥绑定你所在机构的许可。用它们取得的副本只保存在本地（paper_bundles/），不会发送给云端 AI。
# ELSEVIER_API_KEY=                       # https://dev.elsevier.com
# ELSEVIER_INSTTOKEN=                     # only if Elsevier issued you one / 仅当 Elsevier 发放给你时
# WILEY_TDM_TOKEN=                        # Wiley Text and Data Mining token / Wiley TDM 令牌
# OPENALEX_API_KEY=                       # optional; used only for content.openalex.org / 可选
# SEISMO_HARVEST_KEYS_FILE=               # another keys file / 其他密钥文件路径
# Honest User-Agent for the harvester; include a mailto to join the polite pools.
# 抓取器使用的 User-Agent，建议带上 mailto 以进入礼貌池。
# SEISMO_HARVEST_UA=SeismoHub/2.0 (mailto:you@example.org)
# SEISMO_HARVEST_MAX_BYTES=80000000


# -----------------------------------------------------------------------------------------------------
# 6. Server / 服务
# -----------------------------------------------------------------------------------------------------
# `python main.py` listens on 127.0.0.1 only. Without SEISMO_PORT the port is derived from the folder path.
# `python main.py` 只监听 127.0.0.1。不设 SEISMO_PORT 时，端口由文件夹路径推算。
# SEISMO_PORT=8000
# SEISMO_OPEN_BROWSER=1                   # 0 = do not open a browser tab at start / 启动时不打开浏览器
# SEISMO_DB_PATH=./seismo_hub.db          # SQLite file (default: next to main.py) / SQLite 数据库路径
# SWP_MAX_UPLOAD_BYTES=52428800           # upload cap, 50 MB / 上传大小上限
# SWP_ENABLE_DEBUG_ROUTES=                # 1 = expose /debug/papers / 开启调试页面
# SEISMO_SQLITE_BUSY_TIMEOUT_MS=10000


# -----------------------------------------------------------------------------------------------------
# 7. Background jobs / 后台任务
# -----------------------------------------------------------------------------------------------------
# SEISMO_NO_AUTOFETCH=1                   # no background fetching, no startup refresh / 不在后台抓取新论文
# SEISMO_FETCH_THRESHOLD_SECONDS=21600    # fetch when data is older than 6 h / 数据超过 6 小时就抓取
# SEISMO_SCHEDULER_CHECK_SECONDS=300      # how often the scheduler checks / 调度检查间隔
# TRACKER_SCHEDULER_INTERVAL_SEC=300      # per-tracker scheduler pass / 追踪器调度间隔
# SEISMO_NO_PRESET_SEED=1                 # start without the 11 preset trackers / 不预置 11 个追踪器
# SEISMO_MATCH_LLM=1                      # let Gemini break ties when matching uploaded PDFs / 上传匹配时用 AI 裁决
# Test / maintenance switches / 测试与维护开关:
# DISABLE_TRACKER_SCHEDULER=1
# DISABLE_PARAGRAPH_BACKFILL=1
# DISABLE_METADATA_BACKFILL=1
